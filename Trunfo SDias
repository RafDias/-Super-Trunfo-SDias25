typedef struct {
    char estado[3];           // Sigla do estado (ex: SP)
    char codigo[4];           // Código da carta (ex: A01)
    char cidade[50];          // Nome da cidade
    int populacao;            // População
    float area;               // Área em km²
    float pib;                // PIB em bilhões de reais
} Carta;

int main() {
    // Cartas com dados aproximados
    Carta carta1 = {"SP", "A01", "São Paulo", 11253503, 1521.11, 850.0};
    Carta carta2 = {"RJ", "B02", "Rio de Janeiro", 6748000, 1200.27, 400.0};
    Carta carta3 = {"MA", "C03", "São Luís", 1109000, 834.79, 34.0};
    Carta carta4 = {"PI", "D04", "Teresina", 871126, 1367.30, 28.5};

    // Exibição das Cartas
    printf("=========================\n");
    printf("Carta 1 - %s (%s)\n", carta1.cidade, carta1.estado);
    printf("Código: %s\nPopulação: %d habitantes\nÁrea: %.2f km²\nPIB: %.2f bilhões de reais\n",
           carta1.codigo, carta1.populacao, carta1.area, carta1.pib);

    printf("\nCarta 2 - %s (%s)\n", carta2.cidade, carta2.estado);
    printf("Código: %s\nPopulação: %d habitantes\nÁrea: %.2f km²\nPIB: %.2f bilhões de reais\n",
           carta2.codigo, carta2.populacao, carta2.area, carta2.pib);

    printf("\nCarta 3 - %s (%s)\n", carta3.cidade, carta3.estado);
    printf("Código: %s\nPopulação: %d habitantes\nÁrea: %.2f km²\nPIB: %.2f bilhões de reais\n",
           carta3.codigo, carta3.populacao, carta3.area, carta3.pib);

    printf("\nCarta 4 - %s (%s)\n", carta4.cidade, carta4.estado);
    printf("Código: %s\nPopulação: %d habitantes\nÁrea: %.2f km²\nPIB: %.2f bilhões de reais\n",
           carta4.codigo, carta4.populacao, carta4.area, carta4.pib);

    // Comparação simples: PIB
    printf("\n=== Comparação de PIB ===\n");

    // Encontra a cidade com o maior PIB
    Carta maiorPIB = carta1;
    if (carta2.pib > maiorPIB.pib) maiorPIB = carta2;
    if (carta3.pib > maiorPIB.pib) maiorPIB = carta3;
    if (carta4.pib > maiorPIB.pib) maiorPIB = carta4;

    printf("A cidade com o maior PIB é %s (%s) com %.2f bilhões de reais.\n",
           maiorPIB.cidade, maiorPIB.estado, maiorPIB.pib);

    return 0;
}
